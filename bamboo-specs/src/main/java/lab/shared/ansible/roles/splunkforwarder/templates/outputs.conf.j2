## Managed by the forgelab splunkforwarder role.
## Every indexer is listed: the forwarder load-balances across them and keeps
## sending if one is down, which is the whole point of having two.
[tcpout]
defaultGroup = {{ splunk_cluster_label | default('forgelab') }}_indexers

[tcpout:{{ splunk_cluster_label | default('forgelab') }}_indexers]
server = {{ groups['splunk_indexer'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '$', ':' ~ splunkforwarder_s2s_port) | join(',') }}
## Switch indexer every 30s rather than per-file, so one busy log cannot pin all
## of this host's data onto a single peer.
autoLBFrequency = 30
## No useACK: indexer acknowledgement round-trips exceed their 300s window
## against emulated indexers, and the forwarder then re-sends everything it
## never heard back about — "Read operation timed out expecting ACK ... in 300
## seconds", followed by duplicate events. Delivery without end-to-end ACK is
## the right trade for a lab.
